# 이 파일을 .env로 복사해 값을 채운다. .env는 .gitignore에 있어 커밋되지 않는다.
# 배포 환경에서는 같은 이름으로 Vercel 프로젝트 환경변수에 등록한다.
# 주의: OPENAI_API_KEY를 VITE_ 접두사 변수에 넣지 않는다(FE 번들에 포함된다).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_LANGS=python

# 요청 하나에서 에이전트 실행에 쓰는 최대 시간(초)
AGENT_TIMEOUT_SECONDS=60

# 에이전트 시험 API(/api/dev/agent-ping)를 켠다. 배포 환경에서는 false로 둔다.
ENABLE_DEV_ROUTES=false

# 원격 MCP 엔드포인트(/mcp). 두 값이 모두 있어야 열린다(비우면 닫힘).
# MCP_TOKENS: 사용자에게 나눠 줄 접속 토큰(쉼표로 여러 개). 예: openssl rand -hex 24
# MCP_SEAL_KEY: 정답을 암호화하는 서버 비밀값. 사용자에게 주지 않는다. 예: openssl rand -hex 32
MCP_TOKENS=
MCP_SEAL_KEY=
