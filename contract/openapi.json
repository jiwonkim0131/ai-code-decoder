                }
              }
            }
          },
          "400": {
            "description": "입력 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "호출 한도",
            "content": {
              "application/json": {
