  "components": {
    "schemas": {
      "AnalyzeMeta": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "toolCalls": {
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "type": "array",
            "title": "Toolcalls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model"
        ],
        "title": "AnalyzeMeta"
      },
      "AnalyzeRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Code"
          },
          "level": {
            "type": "string",
            "enum": [
              "basic",
              "work",
              "deep"
            ],
            "title": "Level",
            "default": "work"
          },
          "focusLines": {
            "items": {
              "type": "integer",
              "minimum": 1.0
            },
            "type": "array",
            "title": "Focuslines"
          },
          "question": {
            "type": "string",
            "maxLength": 1000,
            "title": "Question",
            "default": ""
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "python"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array",
            "title": "Steps"
          },
          "decisionPoints": {
            "items": {
              "$ref": "#/components/schemas/DecisionPoint"
            },
            "type": "array",
            "title": "Decisionpoints"
          },
          "meta": {
            "$ref": "#/components/schemas/AnalyzeMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "language",
          "steps",
          "decisionPoints",
          "meta"
        ],
        "title": "AnalyzeResponse"
      },
      "CodeChoice": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "intent": {
            "$ref": "#/components/schemas/Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "summary",
          "intent"
        ],
        "title": "CodeChoice",
        "description": "이 코드의 선택. 작성자 의도는 항상 \"추정\" 배지다."
      },
      "Condition": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "splits": {
            "items": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            },
            "type": "array",
            "title": "Splits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "explanation"
        ],
        "title": "Condition",
        "description": "결정을 가른 조건. 분석 때 한 번 만들어 고정하며 제출 전에는 화면에 보이지 않는다."
      },
      "ConditionVerdict": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "hit",
                  "miss"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "note"
        ],
        "title": "ConditionVerdict"
      },
      "DecisionPoint": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "stepId": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Stepid"
          },
          "lines": {
            "items": {
              "type": "integer",
              "minimum": 1.0
            },
            "type": "array",
            "minItems": 1,
            "title": "Lines"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Options"
          },
          "hint": {
            "type": "string",
            "title": "Hint"
          },
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array",
            "minItems": 1,
            "title": "Conditions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "stepId",
          "lines",
          "prompt",
          "options",
          "hint",
          "conditions"
        ],
        "title": "DecisionPoint",
        "description": "결정 지점 1개 = \"너라면?\" 1문제."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Evidence": {
        "properties": {
          "badge": {
            "type": "string",
            "enum": [
              "official",
              "inferred",
              "needs_check"
            ],
            "title": "Badge"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "badge"
        ],
        "title": "Evidence",
        "description": "사실 주장 하나에 붙는 근거 배지. official이면 url이 반드시 있다."
      },
      "FeedbackRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Code"
          },
          "preset": {
            "type": "string",
            "enum": [
              "latency",
              "rateLimit",
              "traffic",
              "team"
            ],
            "title": "Preset"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "preset",
          "question",
          "answer"
        ],
        "title": "FeedbackRequest"
      },
      "FeedbackResponse": {
        "properties": {
          "verdict": {
            "type": "string",
            "title": "Verdict"
          },
          "points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Points"
          },
          "further": {
            "type": "string",
            "title": "Further"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "verdict",
          "points",
          "further"
        ],
        "title": "FeedbackResponse"
      },
      "JudgeRequest": {
        "properties": {
          "decisionPoint": {
            "$ref": "#/components/schemas/DecisionPoint"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "choice": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "title": "Reason",
            "default": ""
          },
          "level": {
            "type": "string",
            "enum": [
              "basic",
              "work",
              "deep"
            ],
            "title": "Level",
            "default": "work"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decisionPoint"
        ],
        "title": "JudgeRequest"
      },
      "MyAnswer": {
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "title": "Choice"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "choice",
          "reason"
        ],
        "title": "MyAnswer"
      },
      "Option": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "Option"
      },
      "ScanRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "ScanRequest"
      },
      "ScanResponse": {
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/SecretFinding"
            },
            "type": "array",
            "title": "Findings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "findings"
        ],
        "title": "ScanResponse"
      },
      "ScenarioRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Code"
          },
          "preset": {
            "type": "string",
            "enum": [
              "latency",
              "rateLimit",
              "traffic",
              "team"
            ],
            "title": "Preset"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "preset"
        ],
        "title": "ScenarioRequest"
      },
      "ScenarioResponse": {
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "latency",
              "rateLimit",
              "traffic",
              "team"
            ],
            "title": "Preset"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "followUp": {
            "type": "string",
            "title": "Followup"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "preset",
          "question",
          "followUp"
        ],
        "title": "ScenarioResponse"
      },
      "SecretFinding": {
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Line"
          },
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "preview": {
            "type": "string",
            "title": "Preview"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "line",
          "start",
          "end",
          "kind",
          "preview"
        ],
        "title": "SecretFinding",
        "description": "비밀값 후보. start·end는 그 줄 안의 문자 위치(0부터, end는 미포함)다."
      },
      "Step": {
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "lines": {
            "items": {
              "type": "integer",
              "minimum": 1.0
            },
            "type": "array",
            "minItems": 1,
            "title": "Lines"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "io": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StepIO"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "isDecision": {
            "type": "boolean",
            "title": "Isdecision",
            "default": false
