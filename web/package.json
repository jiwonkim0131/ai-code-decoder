{
  "name": "ai-code-decoder-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../contract/openapi.json -o src/api/schema.ts --default-non-nullable false"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
